{'problem_index': 111, 'code': 'theorem amc12_2001_p2 (a b n : ℕ) (h₀ : 1 ≤ a ∧ a ≤ 9) (h₁ : 0 ≤ b ∧ b ≤ 9) (h₂ : n = 10 * a + b)\n  (h₃ : n = a * b + a + b) : b = 9 := by\n  have h₄ : a ≤ 9 := by linarith\n  have h₅ : 0 ≤ a := by linarith\n  have h₆ : 0 ≤ b := by linarith\n  have h₇ : b ≤ 9 := by linarith\n  have h₈ : a * b ≤ 9 * 9 := by nlinarith\n  have h₉ : a * b ≤ 81 := by linarith\n  have h₁₀ : 10 * a + b = a * b + a + b := by linarith\n  have h₁₁ : 10 * a = a * b + a := by linarith\n  have h₁₂ : 10 * a - a = a * b := by omega\n  have h₁₃ : 9 * a = a * b := by omega\n  have h₁₄ : a * b = 9 * a := by omega\n  have h₁₅ : a * b = 9 * a := by omega\n  have h₁₆ : b = 9 := by\n    apply Eq.symm\n    apply Nat.eq_of_le_of_lt_succ <;> nlinarith\n  exact h₁₆\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega\n  <;> omega', 'result': 'no bug, can double check'}
