theorem aime_1990_p15
  (a b x y : ℝ)
  (h₀ : a * x + b * y = 3)
  (h₁ : a * x^2 + b * y^2 = 7)
  (h₂ : a * x^3 + b * y^3 = 16)
  (h₃ : a * x^4 + b * y^4 = 42) :
  a * x^5 + b * y^5 = 20 := by
  have h₄ := congr_arg (fun t => a * x * t + b * y * t) h₀
  have h₅ := congr_arg (fun t => a * x ^ 2 * t + b * y ^ 2 * t) h₀
  have h₆ := congr_arg (fun t => a * x ^ 3 * t + b * y ^ 3 * t) h₀
  have h₇ := congr_arg (fun t => a * x ^ 4 * t + b * y ^ 4 * t) h₀
  ring_nf at h₄ h₅ h₆ h₇ ⊢
  nlinarith [sq_nonneg (x - 1), sq_nonneg (y - 1), sq_nonneg (x + 1), sq_nonneg (y + 1),
    sq_nonneg (x - y), sq_nonneg (x + y), sq_nonneg (x * y - 1), sq_nonneg (x * y + 1)]
