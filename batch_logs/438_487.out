    -- Apply the AM-GM inequality to each term
    have h₆ : ∀ n : ℕ, ((a + b) / 2) ^ n ≤ (a ^ n + b ^ n) / 2 := by
      intro n
      -- Use the fact that the arithmetic mean is less than or equal to the geometric mean
      have h₇ : 0 ≤ a ^ n := pow_nonneg (le_of_lt h₂) n
      have h₈ : 0 ≤ b ^ n := pow_nonneg (le_of_lt h₃) n
      have h₉ : 0 ≤ a ^ n * b ^ n := mul_nonneg h₇ h₈
      -- Use the AM-GM inequality to prove the desired inequality
      nlinarith [sq_nonneg (a - b), pow_two_nonneg (a - b), pow_two_nonneg (a + b),
        pow_two_nonneg (a ^ n - b ^ n), pow_two_nonneg (a ^ n + b ^ n)]
    exact h₆ n
  exact h₅
