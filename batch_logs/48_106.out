theorem mathd_algebra_510 (x y : ℝ) (h₀ : x + y = 13) (h₁ : x * y = 24) :
  Real.sqrt (x ^ 2 + y ^ 2) = 11 := by
  have h₂ : x ^ 2 + y ^ 2 = 11 ^ 2 := by
    nlinarith [sq_nonneg (x - y)]
  rw [h₂]
  exact Real.sqrt_sq (by norm_num)
