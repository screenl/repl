theorem mathd_numbertheory_156 (n : ℕ) (h₀ : 0 < n) : Nat.gcd (n + 7) (2 * n + 1) ≤ 13 := by
  have h₁ : Nat.gcd (n + 7) (2 * n + 1) ≤ 13 := by
    have h₂ : Nat.gcd (n + 7) (2 * n + 1) ∣ 13 := by
      have h₃ : Nat.gcd (n + 7) (2 * n + 1) ∣ n + 7 := Nat.gcd_dvd_left (n + 7) (2 * n + 1)
      have h₄ : Nat.gcd (n + 7) (2 * n + 1) ∣ 2 * n + 1 := Nat.gcd_dvd_right (n + 7) (2 * n + 1)
      have h₅ : Nat.gcd (n + 7) (2 * n + 1) ∣ 13 := by
        have h₆ : 13 = 2 * (n + 7) - (2 * n + 1) := by omega
        rw [h₆]
        exact dvd_sub' (dvd_mul_of_dvd_right h₃ 2) h₄
      exact h₅
    exact Nat.le_of_dvd (by norm_num) h₂
  exact h₁
