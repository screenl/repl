    have h₂ : 14*n + 3 > 0 := by linarith
    have h₃ : 21*n + 4 > 0 := by linarith
    have h₄ : 21*n + 4 = 14*n + 3 + (7*n + 1) := by omega
    rw [h₄]
    simp [Nat.gcd_comm, Nat.gcd_assoc, Nat.gcd_one_right]
    <;> omega
  exact h₁
```
